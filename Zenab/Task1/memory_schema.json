{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "WANAS Personal Memory Database Schema — Hardened Demo/Production Records",
  "type": "object",
  "required": [
    "schema_version",
    "dataset_name",
    "persons"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "minLength": 1
    },
    "dataset_name": {
      "type": "string",
      "minLength": 1
    },
    "governance_note": {
      "type": "string"
    },
    "persons": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "person_id",
          "name",
          "relationship_to_wearer",
          "source_type",
          "status",
          "facts"
        ],
        "properties": {
          "person_id": {
            "type": "string",
            "pattern": "^person-[0-9]{3}$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "relationship_to_wearer": {
            "type": "string",
            "minLength": 1
          },
          "source_type": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "minLength": 1
          },
          "facts": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "fact_id",
                "fact_type",
                "memory_fact",
                "display_tier",
                "source_type",
                "verification_status",
                "review_status",
                "last_updated"
              ],
              "properties": {
                "fact_id": {
                  "type": "string",
                  "pattern": "^person-[0-9]{3}-F[0-9]{2,}$"
                },
                "fact_type": {
                  "type": "string",
                  "enum": [
                    "identity_relationship",
                    "personal_interest",
                    "location_context",
                    "shared_memory",
                    "practical_support",
                    "conversation_starter"
                  ]
                },
                "memory_fact": {
                  "type": "string",
                  "minLength": 1
                },
                "display_tier": {
                  "type": "integer",
                  "enum": [
                    1,
                    2
                  ]
                },
                "source_type": {
                  "type": "string",
                  "minLength": 1
                },
                "verification_status": {
                  "type": "string",
                  "minLength": 1
                },
                "review_status": {
                  "type": "string",
                  "minLength": 1
                },
                "last_updated": {
                  "type": "string",
                  "format": "date"
                }
              }
            },
            "minItems": 1
          }
        }
      },
      "minItems": 1
    }
  },
  "description": "Structure and provenance validation only. Uniqueness, approval policy, cross-record identity isolation, and access authorization require separate application checks.",
  "$comment": "Do not treat valid schema as caregiver approval. Production eligibility is enforced by MemoryRetriever. fact_id uniqueness and person_id/fact_id alignment are checked by Step 7 integrity test."
}
